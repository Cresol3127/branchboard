# Copy to .env, or use the toolbar's provider settings.
# Settings writes branchboard.providers.json (gitignored), which overrides these defaults.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Ollama needs no key. Install a model first, e.g. ollama pull llama3.2.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Direct Ollama Cloud (separate from local Ollama, no local installation needed).
# Create a key at https://ollama.com/settings/keys
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gpt-oss:120b
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
# Every provider also accepts its corresponding *_BASE_URL and *_MODEL defaults.
PORT=3001
# Local-only by default. Put authentication in front before exposing publicly.
HOST=127.0.0.1
